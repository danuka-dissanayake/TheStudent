# Protect the legacy TheStudent website directory (Apache / LiteSpeed).
#
# The real values live in `config.secrets.php` (loaded by PHP from the
# filesystem — it never needs to be reachable over HTTP. Denying it here means
# that even if PHP stops executing (misconfiguration, temporary outage, a host
# that serves unknown files as text), the credentials cannot be downloaded.

Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(^config\.secrets.*\.php$|^config\.secrets.*|.*\.sql$|^README.*\.md$)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(^config\.secrets.*\.php$|^config\.secrets.*|.*\.sql$|^README.*\.md$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Never serve a dotfile (.env, .git, editor backups).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Basic hardening headers for anything served from here.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
