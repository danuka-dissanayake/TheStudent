<full-backup-content>
    <!-- Never copy the session store off the device: even though the token is
         Keystore-encrypted, nothing auth-related belongs in a cloud backup. -->
    <exclude domain="sharedpref" path="thestudent_user_session.xml" />
</full-backup-content>
