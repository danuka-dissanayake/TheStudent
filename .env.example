# =============================================================================
# TheStudent — ANDROID APP SECRETS  (single source of truth)
# =============================================================================
#
# HOW THIS WORKS
#   1. Copy this file:            cp .env.example .env
#   2. Fill in the real values in .env
#   3. Rebuild the app:           ./gradlew assembleDebug
#
#   `.env` is git-ignored and is read at BUILD TIME by the Secrets Gradle Plugin
#   (see `secrets { }` in app/build.gradle.kts). Every key below becomes a
#   `BuildConfig.<KEY>` constant, which is how the Kotlin code reads them:
#
#       BuildConfig.GEMINI_API_KEY
#       BuildConfig.HF_API_TOKEN
#       BuildConfig.GOOGLE_WEB_CLIENT_ID
#
#   `app/build.gradle.kts` falls back to THIS file when `.env` is missing, so a
#   fresh clone still compiles — the placeholder values simply mean "not
#   configured" and the features degrade gracefully instead of crashing.
#
# RULES
#   • Never commit `.env`. Never paste a real key into a .kt/.php file.
#   • A key compiled into the APK is NOT secret: anyone can unzip the APK and
#     read it. Treat app-side keys as "rate-limited public" and keep the
#     valuable ones server-side (see docs/SECRETS.md).
#   • After editing this file, do a clean rebuild — BuildConfig is generated.
#
# =============================================================================


# --- Google Gemini ------------------------------------------------------------
# https://aistudio.google.com/apikey  →  "Create API key"
# Used by: TheStudentStudyAiClient (text/vision), TheStudentOcrEngine
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Z.AI / GLM (free tier chat) ---------------------------------------------
# https://z.ai  →  API keys. Either name works; ZAI_API_KEY wins if both are set.
ZAI_API_KEY=YOUR_ZAI_API_KEY_HERE
Z_AI_API_KEY=YOUR_Z_AI_API_KEY_HERE

# --- Hugging Face -------------------------------------------------------------
# https://huggingface.co/settings/tokens  →  "New token" (read scope is enough)
# Used by: TheStudentStudyAiClient (GPT-OSS space), HuggingFaceSpaceClient
# NOTE: this used to have a hardcoded fallback in the source; it was removed.
#       If this is empty, the AI tutor shows "not configured on this build".
HF_API_TOKEN=YOUR_HF_ACCESS_TOKEN_HERE

# --- Google Sign-In -----------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# type "Web application". This is the *Web* client ID (public identifier).
# It MUST be byte-identical to GOOGLE_WEB_CLIENT_ID in
# backend/config.secrets.php, otherwise the server rejects the ID token with
# "Token audience mismatch".
GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Firebase App Check (debug builds only) -----------------------------------
# This one is on the plugin's ignoreList, so it is NOT exposed as BuildConfig.
# Leave it out unless you are debugging App Check locally.
# FIREBASE_APPCHECK_DEBUG_TOKEN=false
